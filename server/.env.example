# ──────────────────────────────────────────────
# CONNECT GREEN — Server Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to Git
# ──────────────────────────────────────────────

# Server
PORT=5000
NODE_ENV=development   # change to 'production' on Render

# MongoDB connection string
MONGO_URI=

# Generate with: node -e "process.stdout.write(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Comma-separated frontend origins. Production requires explicit HTTPS origins.
ALLOWED_ORIGINS=http://localhost:5173

# Development seed only. Use a private value; never use this in production.
DEMO_PASSWORD=
ALLOW_DESTRUCTIVE_SEED=false
ALLOW_SOURCE_DROP=false

# Cloudinary — for image uploads
# Get from: https://cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
